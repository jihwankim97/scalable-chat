datasource db {
    provider    ="postgresql"
    url         =env("DB_URL")
}

generator client {
    provider = "prisma-client-js"
    previewFeatures = ["prismaSchemaFolder", "omitApi"]
}


enum Role {
    admin
    paidUser
    user
}


model User {
    id              Int                 @id @default(autoincrement())
    email           String              @unique
    password        String              
    role            Role                @default(user)
    createdAt       DateTime            @default(now())
    updatedAt       DateTime            @updatedAt @default(now())
}

